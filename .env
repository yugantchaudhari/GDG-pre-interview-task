# ============================================================
# Group 1 — Application
# ============================================================
APP_NAME=Insurance Cost Predictor Microservice
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
DEBUG=True
DEFAULT_CURRENCY=USD

# ============================================================
# Group 2 — File Paths
# ============================================================
DATASET_FILE_PATH=app/data/insurance.csv
ARTIFACTS_DIR=app/artifacts
BEST_PIPELINE_FILENAME=best_pipeline.joblib
ALL_MODELS_FILENAME=all_models.joblib
EVALUATION_REPORT_FILENAME=evaluation_report.json

# ============================================================
# Group 3 — Domain & Preprocessing Thresholds
# ============================================================
BMI_UNDERWEIGHT_THRESHOLD=18.5
BMI_NORMAL_THRESHOLD=25.0
BMI_OBESE_THRESHOLD=30.0
AGE_SENIOR_RISK_THRESHOLD=50
SKEWNESS_HIGH_THRESHOLD=0.75
POWER_TRANSFORM_METHOD=yeo-johnson
OHE_DROP_STRATEGY=if_binary
OHE_HANDLE_UNKNOWN=ignore

# ============================================================
# Group 4 — DTO Validation Bounds
# ============================================================
VALIDATION_AGE_MIN=18
VALIDATION_AGE_MAX=100
VALIDATION_BMI_MIN=10.0
VALIDATION_BMI_MAX=65.0
VALIDATION_CHILDREN_MIN=0
VALIDATION_CHILDREN_MAX=15
VALIDATION_CV_FOLDS_MIN=2
VALIDATION_CV_FOLDS_MAX=20

# ============================================================
# Group 5 — ML Defaults & Hyperparameters
# ============================================================
DEFAULT_CV_FOLDS=5
DEFAULT_RANDOM_STATE=42
DEFAULT_DROP_DUPLICATES=True
DEFAULT_HANDLE_FEATURE_SKEW=True
DEFAULT_APPLY_LOG_TARGET=True
DEFAULT_INCLUDE_INTERACTIONS=True

# Linear Regression
LR_FIT_INTERCEPT=True

# Random Forest
RF_N_ESTIMATORS=200
RF_MAX_DEPTH=8
RF_MIN_SAMPLES_SPLIT=5
RF_MIN_SAMPLES_LEAF=2
RF_N_JOBS=-1

# Gradient Boosting
GB_N_ESTIMATORS=150
GB_LEARNING_RATE=0.05
GB_MAX_DEPTH=4
GB_SUBSAMPLE=0.85
GB_MIN_SAMPLES_SPLIT=5

# ============================================================
# Group 6 — Actuarial Fallback Engine Weights
# ============================================================
FALLBACK_BASE_CHARGE=2200.0
FALLBACK_AGE_MULTIPLIER=255.0
FALLBACK_BMI_BASELINE=25.0
FALLBACK_EXCESS_BMI_MULTIPLIER=320.0
FALLBACK_CHILDREN_MULTIPLIER=600.0
FALLBACK_SMOKER_BASE_PENALTY=15500.0
FALLBACK_SMOKER_OBESE_SYNERGY_PENALTY=14000.0

# ============================================================
# Group 7 — Resilience4j Circuit Breaker
# ============================================================
# predict profile
CB_PREDICT_FAILURE_RATE_THRESHOLD=50.0
CB_PREDICT_SLIDING_WINDOW_SIZE=10
CB_PREDICT_MIN_NUMBER_OF_CALLS=5
CB_PREDICT_WAIT_DURATION_IN_OPEN_STATE_SEC=30.0
CB_PREDICT_PERMITTED_CALLS_IN_HALF_OPEN=3

# train profile
CB_TRAIN_FAILURE_RATE_THRESHOLD=50.0
CB_TRAIN_SLIDING_WINDOW_SIZE=5
CB_TRAIN_MIN_NUMBER_OF_CALLS=2
CB_TRAIN_WAIT_DURATION_IN_OPEN_STATE_SEC=60.0
CB_TRAIN_PERMITTED_CALLS_IN_HALF_OPEN=1

# eda profile
CB_EDA_FAILURE_RATE_THRESHOLD=60.0
CB_EDA_SLIDING_WINDOW_SIZE=10
CB_EDA_MIN_NUMBER_OF_CALLS=4
CB_EDA_WAIT_DURATION_IN_OPEN_STATE_SEC=20.0
CB_EDA_PERMITTED_CALLS_IN_HALF_OPEN=2

# ============================================================
# Group 8 — Resilience4j Rate Limiter
# ============================================================
RL_PREDICT_LIMIT_FOR_PERIOD=60
RL_PREDICT_REFRESH_PERIOD_SEC=60.0

RL_TRAIN_LIMIT_FOR_PERIOD=2
RL_TRAIN_REFRESH_PERIOD_SEC=60.0

RL_EDA_LIMIT_FOR_PERIOD=30
RL_EDA_REFRESH_PERIOD_SEC=60.0

# ============================================================
# Group 9 — Resilience4j Bulkhead
# ============================================================
BH_PREDICT_MAX_CONCURRENT_CALLS=20
BH_PREDICT_MAX_WAIT_DURATION_SEC=0.5

BH_TRAIN_MAX_CONCURRENT_CALLS=1
BH_TRAIN_MAX_WAIT_DURATION_SEC=0.0

BH_EDA_MAX_CONCURRENT_CALLS=10
BH_EDA_MAX_WAIT_DURATION_SEC=0.5

# ============================================================
# Group 10 — Resilience4j TimeLimiter
# ============================================================
TL_PREDICT_TIMEOUT_SEC=2.0
TL_TRAIN_TIMEOUT_SEC=30.0
TL_EDA_TIMEOUT_SEC=5.0

# ============================================================
# Group 11 — Resilience4j Retry & Fallback Toggles
# ============================================================
RETRY_MAX_ATTEMPTS=3
RETRY_WAIT_DURATION_SEC=0.2
RETRY_BACKOFF_MULTIPLIER=2.0
ENABLE_FALLBACK_ON_PREDICT=True
ENABLE_FALLBACK_ON_METRICS=True

# ============================================================
# Group 12 — SLF4J Console Logging
# ============================================================
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s.%(msecs)03d | %(levelname)-8s | [traceId=%(trace_id)s] | [%(threadName)s:%(process)d] | %(name)s:%(funcName)s:%(lineno)d - %(message)s
LOG_DATE_FORMAT=%Y-%m-%d %H:%M:%S